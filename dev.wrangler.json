{
	"$schema": "node_modules/typeflare/schema.json",
	"name": "tutorflow",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"minify": false,
	"main": "./server/index.ts",
	"observability": {
		"enabled": true
	},
	"vars": {
		"NODE_ENV": "production",
		"BUN_VERSION": "1.2.15",
		"SKIP_ENV_VALIDATION": true
	},
	"send_metrics": false,
	"typeflare": {}
}
