{
	"$schema": "https://ui.shadcn.com/schema.json",
	"style": "radix-nova",
	"rsc": false,
	"tsx": true,
	"tailwind": {
		"config": "",
		"css": "components/style.css",
		"baseColor": "neutral",
		"cssVariables": true,
		"prefix": ""
	},
	"iconLibrary": "lucide",
	"aliases": {
		"components": "@/components",
		"utils": "@/lib/utils",
		"ui": "@/components/ui",
		"lib": "@/lib",
		"hooks": "@/hooks"
	},
	"rtl": false,
	"menuColor": "default",
	"menuAccent": "subtle",
	"registries": {
		"@reui": "https://reui.io/r/{style}/{name}.json",
		"@shadcn-editor": "https://raw.githubusercontent.com/htmujahid/shadcn-editor/refs/heads/main/public/r/{name}.json"
	}
}
